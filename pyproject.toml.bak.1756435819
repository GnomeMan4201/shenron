[build-system]
requires = ["setuptools>=68", "wheel"]
build-backend = "setuptools.build_meta"

[project]
name = "shenron-core"
version = "0.1.0"
description = "Adaptive red-team research framework (research-only)."
readme = "README.md"
requires-python = ">=3.10"
authors = [{name="Aaron Brosch"}]
license = {text = "MIT"}
dependencies = []

[project.optional-dependencies]

[project.scripts]
shenron = "shenron_core.cli:main"

[project.scripts]
shenron = "shenron_core.cli:main"
dev = ["pytest", "pytest-cov", "ruff", "mypy", "pre-commit"]

[tool.ruff]
line-length = 100

[tool.pytest.ini_options]
minversion = "8.0"
addopts = "-q"
testpaths = ["tests"]

[project.urls]
Homepage = "https://github.com/GnomeMan4201/shenron"
Source = "https://github.com/GnomeMan4201/shenron"
Issues = "https://github.com/GnomeMan4201/shenron/issues"
Changelog = "https://github.com/GnomeMan4201/shenron/releases"
