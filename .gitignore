# Python bytecode — never commit
__pycache__/
*.pyc
*.pyo

# SHENRON runtime dirs
.shenron/
logs/
reports/
release/

# Keep source packages under core/reports
!core/reports/
!core/reports/*.py

# Build artifacts
build/
dist/
shenron.egg-info/
frontend/dist/

# Frontend dependencies
frontend/node_modules/

# Mutation / generated layer variants — never commit
core/layers/*_??????_*.py

# Backup files
*.bak

# Stray output / scratch files
devto_post.sh
github_botnet_discovery_revised.md

# shenron_manifest.json is intentionally tracked — required by core/validation, core/scenarios, core/reports
# Regenerate with: python3 scripts/build_mitre_metadata.py

# Social botnet and undead layers are intentionally tracked
!core/layers/social_botnet_corpus.py
!core/layers/undead_memory_latch.py

# Cache and local databases
.cache/
shenron_core.zip
shenron_runs.db
*.db
