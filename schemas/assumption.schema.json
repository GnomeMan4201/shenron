{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ShenronAssumption",
  "description": "A SHENRON assumption YAML structure (as parsed to dict)",
  "type": "object",
  "required": ["id", "description", "claims"],
  "properties": {
    "id":          { "type": "string" },
    "description": { "type": "string" },
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "severity"],
        "properties": {
          "id":       { "type": "string" },
          "type":     { "type": "string", "enum": ["positive_evidence", "negative_evidence", "structural"] },
          "severity": { "type": "string", "enum": ["high", "medium", "low"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
